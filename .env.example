# ───────────────────────────── Jigar Matka House API ─────────────────────────────
# Copy to .env for local development. Placeholders only — never commit real secrets.

NODE_ENV=development
PORT=4000
# LOG_LEVEL=info

# 32+ random characters. Signs CSRF and order-confirmation tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# MongoDB must be a replica set (transactions). Local: `npm run dev:db`. Production: Atlas or a replica set.
MONGODB_URI=mongodb://127.0.0.1:27018/jigar_matka?replicaSet=rs0&directConnection=true
# Per API instance; instances × pool size must stay below the cluster's connection limit.
MONGODB_MAX_POOL_SIZE=50

# Optional. With Redis, images are processed by the separate worker (BullMQ), rate limits and
# catalogue cache are shared across instances. Without it, jobs run in-process (dev only).
# REDIS_URL=redis://127.0.0.1:6380
# JOBS_DRIVER=bullmq
# On Vercel jobs run inside the request (JOBS_DRIVER=direct, the default there).

# Public origin of the frontend (CORS allowlist, CSRF origin checks, links in emails).
# FRONTEND_URL is accepted as an alias; set one of the two.
PUBLIC_WEB_URL=http://localhost:3000
# Extra allowed origins, comma separated, e.g. a preview domain. Never a wildcard.
# CORS_ORIGINS=
# Express trust proxy setting: number of proxy hops or a subnet list. Must match your load balancer.
TRUST_PROXY=loopback, linklocal, uniquelocal
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# ── Media storage ──
# local = files under STORAGE_LOCAL_DIR (development only); s3 = any S3-compatible object store.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Public base URL for processed images. Local: served by the API at /media and proxied by Next.js.
# Production: your CDN in front of the bucket's /public prefix, e.g. https://cdn.example.com
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=            # for R2 / MinIO / Spaces; leave empty for AWS
# S3_ACCESS_KEY_ID=       # leave empty to use the instance/IAM role
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
MEDIA_MAX_UPLOAD_MB=15
MEDIA_WEBP_QUALITY=82
MEDIA_KEEP_ORIGINALS=false
MEDIA_WORKER_CONCURRENCY=2

# ── WhatsApp ── business number in international format without "+", e.g. 91XXXXXXXXXX.
# The admin setting (Admin → Settings) takes precedence over this value.
# WHATSAPP_BUSINESS_NUMBER=

# ── Storefront cache revalidation (must match the web app's REVALIDATE_SECRET) ──
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-revalidate-secret

# ── Optional email for self-service password reset ──
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Jigar Matka House <no-reply@example.com>"

# Shared with the web app (INTERNAL_API_TOKEN there): its server-side catalogue requests skip
# per-IP rate limits. 24+ random characters. Server-only.
# INTERNAL_API_TOKEN=

# Bearer token for GET /metrics (Prometheus). Metrics are disabled when unset.
# METRICS_TOKEN=

ORDER_NUMBER_PREFIX=JMH
AUDIT_RETENTION_DAYS=730

# ── First Super Admin (used only by `npm run admin:bootstrap`, only when no admin exists) ──
# Remove the password from the environment after bootstrapping; it must be changed at first sign-in.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Store Owner
