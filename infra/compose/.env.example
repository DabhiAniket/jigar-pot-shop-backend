# docker compose configuration — placeholders only. Copy to .env and fill in.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
REVALIDATE_SECRET=
INTERNAL_API_TOKEN=
PUBLIC_WEB_URL=http://localhost:8080
HTTP_PORT=8080
# Plain-HTTP local trial only; keep true behind HTTPS in production.
COOKIE_SECURE=true
# Leave empty to use the bundled MongoDB; set to your Atlas URI in production.
MONGODB_URI=
# local (volume) or s3
STORAGE_DRIVER=local
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
WHATSAPP_BUSINESS_NUMBER=
METRICS_TOKEN=
SMTP_URL=
MAIL_FROM=
# First Super Admin — used once by bootstrap-admin, then remove the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
